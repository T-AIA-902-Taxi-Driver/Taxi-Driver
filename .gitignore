# Models: raw checkpoints are ignored, final deliverable models are committed
models/*
!models/.gitkeep
!models/final/

# Results: raw experiment data is ignored, aggregated tables and figures are committed
results/*
!results/.gitkeep
!results/aggregated/
!results/figures/
!results/r_star.json
# TrackMania campaign record (small text files); TensorBoard events,
# replay-buffer snapshots and raw console logs stay local
!results/trackmania/
results/trackmania/tb/
results/trackmania/*.pkl
results/trackmania/*.log
results/trackmania/*.pid

